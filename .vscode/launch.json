{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CIFAR-10 CNN (LeakyReLU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["cifar-cnn", "--activation", "leakyrelu"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CIFAR-10 CNN (Tanh)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["cifar-cnn", "--activation", "tanh"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Transfer: AlexNet on CIFAR-10",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["transfer-imagenet"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Transfer: MNIST to SVHN",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["transfer-mnist-svhn"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Quick test run (1 epoch each)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["cifar-cnn", "--epochs", "1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
